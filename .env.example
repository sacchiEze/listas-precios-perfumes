# ==============================================================================
# VARIABLES DE ENTORNO - COMPARADOR MAYORISTA DE PERFUMES
# Copiá este archivo a ".env.local" para desarrollo local y configurá las
# mismas claves en Vercel -> Project Settings -> Environment Variables.
# ==============================================================================

# Conexión pública a Supabase (cliente navegador y servidor)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Podés usar la nueva Publishable key (sb_publishable_...) o la Anon key legacy
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave-publica
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio privada de Supabase (solo usada en Route Handlers del servidor)
# Podés usar la nueva Secret key (sb_secret_...) o la Service Role key legacy
SUPABASE_SECRET_KEY=sb_secret_tu-clave-secreta
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Clave privada de acceso personal para proteger la app en Vercel
CLAVE_ACCESO_APP=tu-clave-secreta-personal

# ==============================================================================
# VARIABLES OPCIONALES PARA SINCRONIZACIÓN DE IMÁGENES (FRAGRANTICA / ALGOLIA)
# ==============================================================================
# Si el endpoint público cambia de credenciales o querés sobreescribir el índice:
# FRAGRANTICA_ALGOLIA_APP_ID=
# FRAGRANTICA_ALGOLIA_API_KEY=
# FRAGRANTICA_ALGOLIA_INDEX=fragrantica_perfumes
